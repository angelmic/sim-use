# Copy this file to .sim-use-e2e.local.env and replace every placeholder.
# The local file is gitignored. Use plain KEY=value lines: this loader does
# not evaluate shell syntax. Non-empty environment variables override it.
SIM_USE_DEVICE_UDID=<physical-iphone-udid>
SIM_USE_TVOS_DEVICE_UDID=<physical-apple-tv-udid>
SIM_USE_PLAYGROUND_BUNDLE_ID=com.example.SimUsePlayground
SIM_USE_TVOS_BUNDLE_ID=com.example.SimUsePlaygroundTV
SIM_USE_WDA_BUNDLE_ID=com.example.WebDriverAgentRunner
SIM_USE_TVOS_WDA_BUNDLE_ID=com.example.WebDriverAgentRunner
SIM_USE_XCODE_ORG_ID=<apple-team-id>
